rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cross-device sync — a sync code IS the access control (anyone who has the code, shared
    // out of band by the same person across their own devices, can read/write it). Basic shape
    // validation only.
    //
    // IMPORTANT CAVEAT: same tradeoff as every room/leaderboard document elsewhere in this
    // series — without Firebase Auth + Cloud Functions doing the actual writes server-side,
    // anyone who can reach this Firestore project (which just means knowing the config, not a
    // secret — see src/network/firebase.ts) could call the Firestore SDK/REST API directly.
    // Accepted tradeoff for a personal study log, not a guarantee against a determined
    // attacker.
    match /syncs/{code} {
      allow read: if true;
      allow write: if request.resource.data.stats is map
                   && request.resource.data.history is list
                   && request.resource.data.history.size() <= 200;
    }
  }
}
